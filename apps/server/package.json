{
  "name": "@mcproxy/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
