    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "service": "node --env-file-if-exists=../../.env dist/service.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
